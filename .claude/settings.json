{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|NotebookEdit|Bash|PowerShell|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-env.cjs\"",
            "timeout": 10,
            "statusMessage": ".env 보호 검사 중"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/sync-env-example.cjs\"",
            "timeout": 30,
            "statusMessage": ".env.example 동기화 중"
          }
        ]
      }
    ]
  }
}
